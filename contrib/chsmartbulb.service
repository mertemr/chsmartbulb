[Unit]
Description=CHSmartBulb light service
After=bluetooth.target pipewire-pulse.service

[Service]
Environment=CHSMARTBULB_ADDRESS=AA:BB:CC:DD:EE:FF
# Path to the chsmartbulbd executable, for example target/release/chsmartbulbd of a checkout
# (cargo build --release -p chsmartbulb-daemon). The Python service runs the same way, and
# reads the address from ~/.config/chsmartbulb/config when it is not given here:
# /path/to/chsmartbulb daemon
ExecStart=/path/to/chsmartbulbd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

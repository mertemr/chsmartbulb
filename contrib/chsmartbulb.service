[Unit]
Description=CHSmartBulb light service
After=bluetooth.target pipewire-pulse.service

[Service]
# The address is read from ~/.config/chsmartbulb/config; to give it here instead:
# Environment=CHSMARTBULB_ADDRESS=AA:BB:CC:DD:EE:FF
# Path to the chsmartbulb executable, for example the one in the project's .venv/bin
ExecStart=/path/to/chsmartbulb daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

[Unit]
Description=CHSmartBulb light service
After=bluetooth.target pipewire-pulse.service

[Service]
# Leave this out when ~/.config/chsmartbulb/config holds the address.
Environment=CHSMARTBULB_ADDRESS=AA:BB:CC:DD:EE:FF
# Path to the chsmartbulbd executable, for example target/release/chsmartbulbd of a checkout
# (cargo build --release -p chsmartbulb-daemon).
ExecStart=/path/to/chsmartbulbd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

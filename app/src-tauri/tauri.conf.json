{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulb",
  "version": "0.1.0",
  "identifier": "io.github.mertemr.chsmartbulb",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web run dev:app",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../web run build:app",
    "frontendDist": "../../web/dist-app"
  },
  "app": {
    "windows": [
      {
        "title": "Bulb",
        "width": 1040,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Control the CHSmartBulb / BL08A speaker bulb",
    "longDescription": "Colour, brightness, effects and the bulb's own modes over Bluetooth, without the vendor app.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": {
      "minSdkVersion": 24
    }
  }
}
